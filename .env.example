# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Anthropic API key from console.anthropic.com. REQUIRED — the v2 agents
# (agents.core.AnthropicClient) reach Claude over the API only.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Claude model (optional — defaults to claude-opus-4-8).
# CLAUDE_MODEL=claude-opus-4-8

# PostgreSQL
POSTGRES_USER=learnbot
POSTGRES_PASSWORD=learnbot
POSTGRES_DB=learnbot
POSTGRES_HOST=postgres

# v2 Brain (docs/plans/kaizen-v2-rollout.md) uses its OWN logical database in
# the SAME Postgres container — "БД на сервис", no cross-service JOINs. It reuses
# the POSTGRES_USER/PASSWORD/HOST/PORT above and only overrides the db name.
# The `brain` database must exist before `alembic -c brain/alembic.ini upgrade
# head` runs (Brain creates/migrates it in Phase 2; in Phase 1 this is just the
# frozen schema).
# BRAIN_POSTGRES_DB=brain

# Comma-separated Telegram user IDs that are allowed to use the bot (private bot)
ALLOWED_USER_IDS=123456789

# Your timezone (IANA name) — used for reminders and "current time" awareness
TIMEZONE=Europe/Moscow

# --- Web research -------------------------------------------------------
# There is no search API to configure. Claude does the searching itself inside
# the turn — WebSearch/WebFetch on the Max/CLI backend, the server-side
# web_search tool on the API backend. Note that on the API backend each search
# bills on top of tokens.

# --- Project tracker --------------------------------------------------------
# The standalone `tracker` service lets Kaya delegate tasks to your OTHER
# projects and watch them. Set a strong admin token — without it Kaya can't
# delegate (the admin routes reject every request). Generate one with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACKER_ADMIN_TOKEN=change-me-generate-a-strong-token
# Where the bot reaches the tracker. On this compose network the default is
# correct; change only if you run the tracker elsewhere.
# TRACKER_URL=http://tracker:8770
# Port the tracker binds (0.0.0.0) and publishes on the host.
# TRACKER_PORT=8770
# How often (seconds) Kaya checks for finished tasks to notify you about.
# TRACKER_POLL_SECONDS=30
#
# --- Tracker v2: the project HUB (docs/tracker-architecture.md) --------------
# Shared secret letting a MODULE ask Brain to push a message to an agent — this
# is how a finished directive or an agent's question reaches Кая. MUST be the
# SAME value on Brain and on the tracker.
#
# REQUIRED. The tracker REFUSES TO BOOT while this is empty or still the
# template value below — silently dropping every report and question cost five
# of them on the first real project, so "unconfigured" is now loud at boot
# instead. Generate a real value and prove the path end to end with
# `make notify-selftest`:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MODULE_EVENT_TOKEN=change-me-generate-a-strong-token
# Where the tracker reaches Brain to send those events. Correct as-is on this
# compose network.
# BRAIN_URL=http://brain:8772
# The gRPC port projects' Wardens dial to enroll, report and ask questions.
# TRACKER_HUB_BIND_ADDR=0.0.0.0:9104
# How long a project's lease on a directive lasts without a heartbeat. Must
# comfortably exceed the Warden's heartbeat interval (wardenkit sends one every
# 30s): too tight and one slow beat requeues healthy work.
# TRACKER_LEASE_SECONDS=120
# How often the Hub hands out queued work, and how often it looks for dead
# leases to requeue.
# TRACKER_DISPATCH_INTERVAL_SEC=5
# TRACKER_SWEEP_INTERVAL_SEC=30
# How many silent dispatch attempts before you are told a project is offline.
# High enough that an ordinary container restart never messages you.
# TRACKER_DISPATCH_MAX_ATTEMPTS=5
# The Hub's hard ceiling on a held-open question, whatever the project asks for
# — a crashed project must not be able to pin a server handler forever.
# TRACKER_QUESTION_MAX_SEC=1800
#
# NETWORKING: your other projects reach the tracker either by joining this
# compose network (http://tracker:8770 for a poller, tracker:9104 for a Warden)
# or via the published host port. See docs/tracker-integration.md for both tiers.

# --- v2 Brain MCP front door ------------------------------------------------
# Brain is the shared "brain" for v2 agents: MCP memory tools + access-list, on
# its own logical DB. (It replaced the old v1 Context Service.) Admin token
# mints per-agent tokens. Without it, no agents can be minted.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Also unlocks the admin panel (Phase 8) at http://localhost:8772/admin/panel —
# paste this token there to mint agents and edit the access-list.
BRAIN_ADMIN_TOKEN=change-me-generate-a-strong-token
# Port the MCP front door binds (0.0.0.0) and publishes.
# BRAIN_PORT=8772
# Phase 6 delivery/callbacks: shared secret authenticating Brain -> agent pushes
# (a fired reminder). MUST be the SAME value on Brain and every agent (Кая). An
# empty value disables pushes (agents reject them). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DELIVERY_TOKEN=change-me-generate-a-strong-token
# How often Brain checks for due reminders to fire.
# REMINDER_SWEEP_SECONDS=30
# Agent ENROLLMENT (device pairing): a shared secret all YOUR agents know so they
# can ask Brain to connect. You then approve each with `make approve`. Without it
# no agent can enroll (they'd need an explicit token instead). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENROLL_TOKEN=change-me-generate-a-strong-token
# Modules Brain discovers + proxies over gRPC (Phase 4+). Format:
#   "name=host:port,name2=host:port". Empty = built-in memory tools only.
# docker-compose sets this to the mentor, tracker and tools services.
# BRAIN_MODULES=mentor=mentor:9102,tracker=tracker:9103,tools=tools:9105
#
# --- Наставник (mentor) module (Phase 4) -------------------------------------
# The mentor has its OWN logical DB (RAG knowledge, goals, homework) in the same
# Postgres container; it reuses POSTGRES_USER/PASSWORD/HOST/PORT.
# MENTOR_POSTGRES_DB=mentor
# MENTOR_BIND_ADDR=0.0.0.0:9102
#
# Register an agent (token shown ONCE):
#   curl -sX POST http://localhost:8772/admin/agents \
#     -H "Authorization: Bearer $BRAIN_ADMIN_TOKEN" \
#     -H "Content-Type: application/json" -d '{"slug":"kaya"}'

# --- v2 agent Кая (Phase 3) --------------------------------------------------
# Кая = agents.core + Telegram + soul + her own local DB. She reaches Brain over
# MCP with her own agent token. By DEFAULT you don't set one here — she ENROLLS
# on first boot (asks to connect; you run `make approve` to say yes), then stores
# the issued token in her volume and reconnects automatically forever after.
# Only set KAYA_BRAIN_TOKEN if you want to pin an explicit token instead.
# KAYA_BRAIN_TOKEN=
# Where Кая reaches Brain (compose DNS). Defaults to http://brain:8772.
# BRAIN_URL=http://brain:8772
# Кая's own local database name (dialogue history). Defaults to "kaya".
# KAYA_POSTGRES_DB=kaya
# Кая is now the default Telegram bot (the v1 monolith bot was removed), so she
# owns TELEGRAM_BOT_TOKEN outright.
# LLM backend for Кая: "api" (Anthropic API key, per-token) or "cli" (the
# `claude` CLI logged in with a Max subscription — no per-token billing). For
# cli, after `make up dev`/`make up prod` run the one-time login:
#   docker compose --env-file .env -f deploy/docker-compose.yml exec kaya claude
#   # follow the prompts (persists in the volume)
CLAUDE_BACKEND=cli

# Optional cheaper model for Кая's self-check gate (the pass that fact-checks a
# researched answer and scrubs clichés before it is sent). It fires on most
# non-trivial replies, and its style half is deletion-only work, so a smaller
# model does it well. Leave EMPTY unless you have measured a reason to set it:
# empty means the gate reuses the main runner and can --resume the draft's
# session instead of replaying the whole transcript, which is usually the bigger
# saving of the two. The per-turn "Turn usage" log line tells you which wins.
CLAUDE_GATE_MODEL=claude-sonnet-5

# How many newest history turns Кая re-sends with every message (default 16).
# A direct multiplier on the cost of every turn; anything older stays reachable
# through the exchange archive, search_conversations and recall_memory.
# CHAT_CONTEXT_MESSAGES=16

# Which language Кая runs in — her persona, cliché map, and every message she
# sends you directly (see agents/README.md's "Multi-language support"). Only
# "ru" and "en" are fully translated today; anything else makes her refuse to
# boot and log exactly which locale files are missing. Defaults to "en" — if
# you want her in Russian, uncomment this:
# KAYA_LANGUAGE=ru

TRAVELPAYOUTS_TOKEN=your_token_here

# --- Deploy pipeline (tools/deploy) ------------------------------------------
# Lets Кая open/merge the PR that ships `main` into `deploy` (the branch a
# self-hosted GitHub Actions runner watches to redeploy prod — see
# docs/deploy-pipeline.md). A fine-grained GitHub PAT scoped to ONLY this repo
# (Settings -> Developer settings -> Fine-grained tokens), with repository
# permissions "Contents: Read and write" + "Pull requests: Read and write".
# Empty (either one) = the deploy tool refuses to run.
GH_DEPLOY_TOKEN=your-fine-grained-pat
# owner/repo the token is scoped to. No built-in default — set explicitly.
GH_REPO=your-github-username/your-repo
# Branch names, if you ever rename them. Renaming GH_DEPLOY_BRANCH also means
# editing .github/workflows/deploy.yml's `on.push.branches` to match — it's
# hardcoded there, not read from this value.
# GH_MAIN_BRANCH=main
# GH_DEPLOY_BRANCH=deploy

# --- Backups (encrypted pg_dumpall → Yandex S3) ------------------------------
# The `backup` service dumps the WHOLE Postgres cluster (all DBs + roles),
# gzips, age-encrypts, and uploads to Yandex Object Storage on a schedule (and
# on demand from the admin panel). age encrypts to a PUBLIC key — the private
# key stays OFFLINE (your machine), so the server can't decrypt its own backups.
#
# Yandex Object Storage is S3-compatible:
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=kaizen
BACKUP_S3_ACCESS_KEY=your-static-access-key
BACKUP_S3_SECRET_KEY=your-static-secret-key
# age PUBLIC key (recipient). Generate a keypair OFFLINE with `age-keygen`:
#   age-keygen -o key.txt   # keep key.txt (the private identity) OFFLINE
# then paste the "Public key: age1..." line here:
BACKUP_AGE_RECIPIENT=age1yourpublickeyhere
# How often the service auto-backs-up, and how many to keep.
BACKUP_SCHEDULE_HOURS=24
BACKUP_KEEP=30
# Shared token the admin panel uses to reach the backup service's API. Reuses
# BRAIN_ADMIN_TOKEN by default (set above); override only if you want a separate one.
# BACKUP_API_TOKEN=

# Brain's mobile tracker dashboard (/admin/tracker) proxies read-only calls to
# the tracker Hub's HTTP API. Reuses TRACKER_ADMIN_TOKEN (set above) — Brain
# authenticates to tracker the same way Кая's tools already do.
# TRACKER_HTTP_URL=http://tracker:8770

# --- Voice messages (Yandex SpeechKit STT) -----------------------------------
# API key of a service account with the SpeechKit role. Кая transcribes the
# owner's Telegram voice notes with it (sync API, up to ~30s per note).
# Кузя берёт ТОТ ЖЕ ключ и для распознавания, и для синтеза — роль
# ai.speechkit.user покрывает оба.
# Empty = voice messages are politely declined.
YANDEX_STT_API_KEY=your-speechkit-api-key
# Каталог Yandex Cloud — нужен только распознаванию Кузи (у Каи он свой).
# YANDEX_FOLDER_ID=b1g...

# --- Кузя (голосовой агент) --------------------------------------------------
# Кузя живёт НАТИВНО на маке: Docker Desktop не отдаёт контейнеру микрофон.
# Его compose-сервис описан, но спрятан за профилем и вместе со стеком НЕ
# поднимается — см. agents/kuzya/docs/kaizen-integration.md.
#
# Токены общие с Каей: ENROLL_TOKEN (регистрация) и DELIVERY_TOKEN (пуши) уже
# заданы выше — отдельных Кузе не нужно.
#
# Голос и слух (по умолчанию локальные whisper/silero; на сервере — только эти):
# KUZYA_STT_BACKEND=yandex
# KUZYA_TTS_BACKEND=yandex
# KUZYA_YANDEX_VOICE=ermil          # ещё: filipp, jane, omazh, zahar, alena
# KUZYA_WAKE_ENABLED=true           # пробуждение по слову «Кузя», локально
# KUZYA_FOLLOWUP_SECONDS=12         # сколько молчать до «засыпания»
#
# История разговора: db (по умолчанию, своя логическая БД kuzya) | memory.
# memory — осознанный выбор, когда Postgres не виден: в режиме db недоступная
# база роняет старт, а не молчаливо забывает разговоры.
# KUZYA_HISTORY=db
#
# Приём пушей от Brain (напоминания, свои заметки, новости трекера).
# Адрес пустой = не регистрироваться: пока Кузя на ноуте за NAT, а Brain на
# VPS, достучаться до него всё равно нельзя, и напоминания идут через Каю.
# KUZYA_DELIVERY_ADDR=http://kuzya:8782/deliver
# KUZYA_QUIET_HOURS=23:00-08:00     # когда молчать; пусто = говорить всегда
