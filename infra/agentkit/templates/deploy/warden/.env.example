# =============================================================================
# {{PROJECT}} Warden — environment contract (deploy/warden/.env)
# =============================================================================
# Every key the Warden needs appears here, with NO real values. This file is
# committed; `.env` (in this same directory) is not (see .gitignore) and is
# never read or printed by an agent.
#
# It is also mounted OVER /repo/deploy/warden/.env inside the fleet's
# container, so what the agents see when they open their own `.env` is
# exactly this — fake. That is deliberate: a rule an agent is asked to follow
# is a request, a mount is a fact.
# =============================================================================

# Repo-scoped fine-grained PAT: contents:write, pull_requests:write
# (plus workflow:write ONLY if agents will edit CI). Create it yourself; never
# paste it into a chat. Without it the fleet is local-only: it reports a file
# list instead of a PR.
GH_TOKEN=

# What the fleet's commits are authored as.
GIT_USER_NAME=
GIT_USER_EMAIL=

REPO_URL=

# How many Directives this project runs at once. Stays at 1 while the fleet
# works in the owner's single checkout: two Directives would interleave their
# diffs. Raising it needs a worktree per Directive first.
MAX_CONCURRENT=1

# Reasoning effort for the fleet. Low is right while it writes plans and
# decisions, and wrong once it produces code — effort not spent writing is
# effort a reviewer pays back with interest.
REASONING_EFFORT=low
